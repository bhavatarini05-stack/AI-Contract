# Copy to .env and adjust.  Never commit .env (it is gitignored).

# ---- LLM: free + local via Ollama (https://ollama.com) ----
LLM_PROVIDER=ollama                  # ollama | mock (mock = offline, rule-based only)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct     # low RAM? use llama3.2:3b ; GPU? try qwen2.5:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=300

# ---- OCR (Tesseract, free) ----
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGES=eng                    # e.g. eng+spa+fra+deu (install matching language packs)

# ---- Storage (defaults: backend/contracts.db and ./storage) ----
# DATABASE_URL=sqlite:///./contracts.db
# STORAGE_DIR=./storage

# ---- URLs (used for CORS and OAuth redirects) ----
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# ---- Optional integrations: FREE sandbox / test modes only, all off by default ----
# Key for encrypting OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
FERNET_KEY=

# Google Drive (Google Cloud console → OAuth client "Web application",
# redirect URI: http://localhost:8000/integrations/gdrive/callback)
ENABLE_GDRIVE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# DocuSign developer sandbox (https://developers.docusign.com — free)
# redirect URI: http://localhost:8000/integrations/docusign/callback
ENABLE_DOCUSIGN=false
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_SECRET_KEY=
DOCUSIGN_AUTH_SERVER=https://account-d.docusign.com

# Dropbox Sign / HelloSign API key (free test mode: requests are non-binding)
ENABLE_DROPBOX_SIGN=false
DROPBOX_SIGN_API_KEY=
DROPBOX_SIGN_TEST_MODE=true

# Adobe Acrobat Sign developer account (free)
# redirect URI: http://localhost:8000/integrations/adobe_sign/callback
ENABLE_ADOBE_SIGN=false
ADOBE_SIGN_CLIENT_ID=
ADOBE_SIGN_CLIENT_SECRET=
ADOBE_SIGN_SHARD=na1

# ---- Authentication ----
# JWT signing key. Leave empty to auto-generate one into backend/.secret_key (gitignored).
SECRET_KEY=
SESSION_HOURS=12
# The first registered account always becomes admin. Set false to let only admins create users.
ALLOW_REGISTRATION=true
